# PostgreSQL / Prisma Postgres Connection URL for local development or Vercel deployment
# Format Examples:
# Prisma Postgres: "prisma+postgres://accelerate.prisma-data.net/?api_key=your-api-key"
# Vercel / Neon / Supabase PostgreSQL: "postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_refund_agent?schema=public"

# Gemini API Key (Optional: system falls back to zero-config deterministic orchestrator if omitted)
GEMINI_API_KEY="your-gemini-api-key-here"

